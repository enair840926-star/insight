{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "//": "루틴이 무인으로 돌 수 있게 하는 허용 목록. 권한 규칙은 접두 매칭이라 'git add'로 시작하는 명령만 맞는다 — 'git -C <경로> add' 나 'Set-Location ...; git add' 같은 형태는 안 맞으므로 동사별로 쪼개지 않고 'git *' 로 둔다. 되돌릴 수 없는 것만 deny 로 따로 막는다.",

  "//읽기": "git·python만 열어 두면 루틴이 매번 멈춘다. 인사이트를 쓰려면 그전에 cloud/에서 최신 프롬프트를 찾고(ls·Glob) 읽어야(cat·sed) 하는데 그게 다 물어보는 명령이었다. 아래는 전부 읽기 전용이다 — sed는 -n(출력만)으로 좁히고, -i(덮어쓰기)는 걸리지 않는다.",

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(insights/**)",
      "Edit(insights/**)",

      "Bash(cd /c/Users/enair/Desktop/claude/asset-insight*)",
      "Bash(git *)",
      "Bash(python tools/*)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(date *)",
      "Bash(TZ=* date *)",

      "PowerShell(Set-Location C:\\Users\\enair\\Desktop\\claude\\asset-insight*)",
      "PowerShell(git *)",
      "PowerShell(python tools/*)",

      "PowerShell(Get-ChildItem*)",
      "PowerShell(Get-Content*)",
      "PowerShell(Get-Date*)",
      "PowerShell(Select-String*)",
      "PowerShell(Measure-Object*)"
    ],

    "deny": [
      "Bash(python insight.py*)",
      "PowerShell(python insight.py*)",

      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",

      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)"
    ]
  }
}
