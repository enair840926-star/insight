# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   copy .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# 전자공시 OPENDART — https://opendart.fss.or.kr (무료, 일 20,000건)
DART_API_KEY=

# 한국은행 ECOS — https://ecos.bok.or.kr (무료). 거시지표용, 선택사항
ECOS_API_KEY=

# 미 EIA — https://www.eia.gov/opendata/register.php (무료)
# 원유·천연가스 주간 재고. 원자재 3대 축(COT·커브·재고) 중 마지막
EIA_API_KEY=

# 미 USDA — https://quickstats.nass.usda.gov/api (무료)
# 곡물 재고·작황
USDA_API_KEY=

# Anthropic — https://console.anthropic.com (유료). 인사이트 생성용
# 비어 있으면 수집만 하고 프롬프트 파일까지만 만든다. 과금 없음.
ANTHROPIC_API_KEY=
