# docs/ 아래는 전부 dashboard.py가 굽는 산출물이다. PC와 클라우드가
# 각자 굽고 각자 push하므로 거의 매번 충돌하는데, 병합할 의미가 없다.
# 항상 다시 구워서 덮어쓰면 되므로 병합 시도 자체를 막는다.
#
# index.html만 막아 뒀더니 feed.json·version.json이 같은 자리에서 걸렸다
# (실측: PR 병합에서 셋이 함께 충돌). 굽는 것은 셋 다 같은 명령이다 —
# python run.py --skip-collect --no-insight --no-deploy
docs/index.html   -merge -diff
docs/feed.json    -merge -diff
docs/version.json -merge -diff

# 클라우드가 커밋하는 수집 결과도 마찬가지로 병합 대상이 아니다.
cloud/*.json -merge -diff
cloud/*.txt  -merge -diff

# 픽 기록은 정반대다. 덧붙이기만 하는 로그라 한쪽을 버리면 그날 기록이
# 통째로 사라진다. union은 양쪽 줄을 다 남긴다 — 같은 id가 두 번 들어와도
# history.load()가 뒤엣것으로 덮으므로 잃는 것이 없다.
history/*.jsonl merge=union

# 저장소 밖 파일의 사본이다. backup_routines.py 가 filecmp 로 바이트를 재는데
# core.autocrlf=true 라, git이 이 파일들을 건드리면(checkout·stash 따위) 사본만
# CRLF가 되어 LF인 실물과 어긋난다. 고친 것이 없는데 넷 다 '다름'으로 뜬다.
.claude/routines/** text eol=lf
